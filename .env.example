# API Configuration
# VITE_API_URL=https://api.setsugekka.jp
# VITE_CONTACT_API_ENDPOINT=/api/contact

# Analytics (optional)
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX
# VITE_PLAUSIBLE_DOMAIN=setsugekka.jp

# Social Media Links (update in constants.ts)
# These are placeholders - update with real URLs when available

# Email Service (EmailJS)
# Get your credentials at https://www.emailjs.com/
# VITE_EMAILJS_SERVICE_ID=service_xxxxx
# VITE_EMAILJS_TEMPLATE_ID=template_xxxxx
# VITE_EMAILJS_NEWSLETTER_TEMPLATE_ID=template_newsletter
# VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxx

# Sentry Error Tracking (optional)
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
